{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{dist/**,public/**,firestore_images_all.json,server/generated_seeds.json}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index?__route=/api/$1"
    },
    {
      "src": "/",
      "dest": "/api/index?__route=/"
    },
    {
      "src": "/webzine",
      "dest": "/api/index?__route=/webzine"
    },
    {
      "src": "/blog",
      "dest": "/api/index?__route=/blog"
    },
    {
      "src": "/blog/([^/]+)",
      "dest": "/api/index?__route=/blog/$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/index?__route=/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/index?__route=/robots.txt"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
