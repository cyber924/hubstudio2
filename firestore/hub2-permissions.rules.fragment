// ADD inside the existing match /databases/{database}/documents block.
// This is a fragment, NOT a replacement for the shared project's deployed rules.
// Preserve images, prompts, shortsProjects, hub3/hub4 and public read rules.
// Existing matching allow rules are OR-ed: audit overly broad rules separately.

function hub2Owns(data) {
  return request.auth != null && data.get('ownerId', '') == request.auth.uid;
}
function hub2Article(data) {
  return data.get('sourceSite', '') == 'hub2'
    || data.get('siteId', '') == 'hub2'
    || data.get('themePersona', '') == 'hub2';
}
function hub2ValidArticle(data) {
  return hub2Owns(data)
    && data.get('sourceSite', '') == 'hub2'
    && data.get('siteId', '') == 'hub2'
    && data.get('themePersona', '') == 'hub2'
    && data.get('type', '') == 'blog'
    && data.get('status', '') in ['draft', 'published', 'archived']
    && ((data.status == 'published' && data.get('visibility', '') == 'public')
      || (data.status != 'published' && data.get('visibility', '') == 'private'));
}
function hub2Thread(data) {
  return data.get('sourceSite', '') == 'hub2'
    && data.get('recordType', '') == 'hub2Thread';
}

match /publishedContents/{articleId} {
  // The owner's query uses where('ownerId', '==', currentUser.uid).
  allow read: if hub2Owns(resource.data);
  allow create: if hub2ValidArticle(request.resource.data);
  allow update: if hub2Owns(resource.data) && hub2Article(resource.data)
    && hub2ValidArticle(request.resource.data);
  allow delete: if hub2Owns(resource.data) && hub2Article(resource.data);
}

match /contentProjects/{projectId} {
  allow read: if hub2Owns(resource.data);
  allow create: if hub2Owns(request.resource.data)
    && hub2Thread(request.resource.data)
    && request.resource.data.payloadJson is string;
  allow update: if hub2Owns(resource.data) && hub2Thread(resource.data)
    && hub2Owns(request.resource.data) && hub2Thread(request.resource.data)
    && request.resource.data.payloadJson is string;
  allow delete: if hub2Owns(resource.data) && hub2Thread(resource.data);
}
